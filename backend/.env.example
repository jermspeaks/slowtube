# Server
NODE_ENV=development
PORT=6001
# Listen address. Use 127.0.0.1 behind nginx so only the reverse proxy can reach the API.
HOST_BIND=0.0.0.0

# URL users open in the browser (scheme + host + port). Used for OAuth redirects and CORS.
FRONTEND_URL=http://localhost:5200

# Google OAuth — add this exact redirect URI in Google Cloud Console (APIs & Services → Credentials)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:6001/api/auth/youtube/callback

YOUTUBE_API_KEY=your_youtube_api_here

# TMDB (movies / TV)
# TMDB_API_KEY=
# TMDB_READ_ACCESS_TOKEN=

# Database (optional — defaults to ./database/watch-later.db under the backend cwd)
# DATABASE_PATH=./database/watch-later.db

# TV episode refresh (in-process cron)
# TV_EPISODE_REFRESH_ENABLED=true
# TV_EPISODE_REFRESH_TIME=0 0 * * *

# Digest feed refresh
# DIGEST_REFRESH_ENABLED=true
# DIGEST_REFRESH_TIME=0 6 * * *
